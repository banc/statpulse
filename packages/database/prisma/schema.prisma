datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  moduleFormat = "cjs"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  monitors     Monitor[]
  createdAt    DateTime  @default(now())
}

enum MonitorType {
  HTTP
}

enum HttpMethod {
  GET
  HEAD
}

enum MonitorStatus {
  UNKNOWN
  UP
  DOWN
}

model Monitor {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  name            String?
  url             String
  type            MonitorType     @default(HTTP)
  method          HttpMethod      @default(GET)
  expectedStatus  Int             @default(200)
  intervalSeconds Int             @default(60)
  timeoutMs       Int             @default(10000)
  status          MonitorStatus   @default(UNKNOWN)
  isActive        Boolean         @default(true)
  lastCheckedAt   DateTime?
  results         MonitorResult[]
  incidents       Incident[]
  createdAt       DateTime        @default(now())

  @@index([userId, status])
}

model MonitorResult {
  id             String   @default(uuid())
  monitorId      String
  monitor        Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  responseTimeMs Int
  statusCode     Int?
  isUp           Boolean
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@id([id, createdAt])
  @@index([monitorId, createdAt(sort: Desc)])
}

model Incident {
  id         String    @id @default(uuid())
  monitorId  String
  monitor    Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?
  reason     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([monitorId, resolvedAt])
  @@index([monitorId, startedAt(sort: Desc)])
}
